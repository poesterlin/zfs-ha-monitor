# --- MQTT broker the collector publishes to ---
# Single mqtt:// URL with optional user:pass or use the explicit MQTT_USER/MQTT_PASS vars.
MQTT_URL=mqtt://10.0.0.4:1883
MQTT_USER=hass
MQTT_PASS=hass

# --- Topics / naming ---
# Base topic: <MQTT_TOPIC>/<NODE_NAME>/<pool>/<entity>
MQTT_TOPIC=zfs
# Short name of this host, used in entity unique_ids / device names.
NODE_NAME=pve

# --- Behavior ---
# Seconds between poll+publish cycles.
INTERVAL_SECS=60
# Set 1 to publish a single snapshot and exit (useful for testing / cron).
ONCE=0
# Optional: path to a YAML snapshot fixture to publish instead of live ZFS
# (e.g. a DEGRADED pool snapshot). Leave empty to collect live.
FAILURE_FIXTURE=

# --- HA MQTT discovery ---
# Discovery prefix (standard Home Assistant value).
MQTT_DISCOVERY_PREFIX=homeassistant
