[Unit]
Description=ZFS HA Monitor
After=network-online.target zfs.target
Wants=network-online.target

[Service]
Type=simple
# Env file sits next to the binary; secrets are read from it.
EnvironmentFile=/usr/local/bin/.env
ExecStart=/usr/local/bin/zfs-ha-monitor
Restart=on-failure
RestartSec=10
# The process shells out to zpool/smartctl and opens /dev disk nodes,
# so keep the base runtime permissive but sandboxed where safe.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
